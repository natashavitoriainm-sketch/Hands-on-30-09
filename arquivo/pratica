import java.util.Scanner;

public class Main {
    public static void main(String[] args) {

        Scanner entrada = new Scanner(System.in);

        int vidas1 = 3;
        int vidas2 = 3;

        int pontos1 = 0;
        int pontos2 = 0;

        int rodada = 1;

        while (vidas1 > 0 && vidas2 > 0) {

            int numero1 = (int) (Math.random() * 10) + 1;
            int numero2 = (int) (Math.random() * 10) + 1;

            System.out.println("===== RODADA " + rodada + " =====");
            System.out.println();
            System.out.println("Jogador 1 tirou: " + numero1);
            System.out.println("Jogador 2 tirou: " + numero2);
            System.out.println();

            if (numero1 > numero2) {

                System.out.println("""
                        Jogador 1 venceu a rodada!
                        Jogador 2 perdeu uma vida!
                        """);

                vidas2 = vidas2 - 1;
                pontos1 = pontos1 + 10;

            } else if (numero2 > numero1) {

                System.out.println("""
                        Jogador 2 venceu a rodada!
                        Jogador 1 perdeu uma vida!
                        """);

                vidas1 = vidas1 - 1;
                pontos2 = pontos2 + 10;

            } else {

                System.out.println("""
                        Empate!
                        Ninguém perdeu vida.
                        Cada jogador recebeu 5 pontos.
                        """);

                pontos1 = pontos1 + 5;
                pontos2 = pontos2 + 5;
            }

            System.out.println();
            System.out.println("Vidas do Jogador 1: " + vidas1);
            System.out.println("Pontos do Jogador 1: " + pontos1);
            System.out.println();
            System.out.println("Vidas do Jogador 2: " + vidas2);
            System.out.println("Pontos do Jogador 2: " + pontos2);
            System.out.println();

            rodada++;
        }

        System.out.println("""
                ===== RESULTADO FINAL =====

                """);

        System.out.println("Jogador 1");
        System.out.println("Vidas: " + vidas1);
        System.out.println("Pontos: " + pontos1);
        System.out.println();

        System.out.println("Jogador 2");
        System.out.println("Vidas: " + vidas2);
        System.out.println("Pontos: " + pontos2);
        System.out.println();

        if (vidas1 > 0) {
            System.out.println("Vencedor: Jogador 1");
        } else {
            System.out.println("Vencedor: Jogador 2");
        }
    }
}
